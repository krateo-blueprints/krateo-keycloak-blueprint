{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Keycloak (Operator-managed) blueprint values",
  "type": "object",
  "properties": {
    "keycloak": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "instances": { "type": "integer", "minimum": 1 },
        "hostname": { "type": "string", "pattern": "^https://[^/?#\\s]+(/[^?#\\s]*[^/?#\\s])?$", "description": "Stable external base URL, including the https:// scheme (e.g. https://keycloak.example.com), no trailing slash. Keycloak builds the token issuer from it." },
        "image": { "type": "string" },
        "http": {
          "type": "object",
          "properties": {
            "httpEnabled": { "type": "boolean" },
            "tlsSecretName": { "type": "string" },
            "relativePath": { "type": "string", "pattern": "^(/[^?#\\s]*[^/?#\\s])?$", "description": "Serve Keycloak under a path prefix (Keycloak's http-relative-path), e.g. /keycloak: starts with /, no trailing slash; keycloak.hostname must then end with it. Empty = the root." },
            "certificate": {
              "type": "object",
              "properties": {
                "enabled": { "type": "boolean" },
                "issuerRef": {
                  "type": "object",
                  "properties": {
                    "kind": { "type": "string", "enum": ["ClusterIssuer", "Issuer"] },
                    "name": { "type": "string", "minLength": 1 }
                  }
                },
                "extraDnsNames": { "type": "array", "items": { "type": "string", "minLength": 1 } },
                "duration": { "type": "string", "pattern": "^([0-9]+h)?$" }
              }
            }
          }
        },
        "ingress": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "className": { "type": "string" }
          }
        },
        "proxyHeaders": { "type": "string", "enum": ["", "forwarded", "xforwarded"] },
        "additionalOptions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": { "name": { "type": "string" }, "value": { "type": "string" } },
            "required": ["name", "value"]
          }
        }
      }
    },
    "db": {
      "type": "object",
      "properties": {
        "vendor": { "type": "string" },
        "database": { "type": "string" },
        "provider": { "type": "string", "enum": ["cloudnativepg", "external"] },
        "cloudnativepg": {
          "type": "object",
          "properties": {
            "clusterName": { "type": "string" },
            "instances": { "type": "integer", "minimum": 1 },
            "owner": { "type": "string" },
            "imageName": { "type": "string" },
            "storage": {
              "type": "object",
              "properties": {
                "size": { "type": "string" },
                "storageClass": { "type": "string" }
              }
            }
          }
        },
        "host": { "type": "string" },
        "port": { "type": "integer" },
        "secret": {
          "type": "object",
          "properties": {
            "create": { "type": "boolean" },
            "name": { "type": "string" },
            "usernameKey": { "type": "string" },
            "passwordKey": { "type": "string" },
            "username": { "type": "string" },
            "password": { "type": "string", "default": "", "description": "External database password. Required when db.provider=external and db.secret.create=true (empty or change-me refuses to render); it must match your database and cannot be generated." }
          }
        }
      }
    },
    "bootstrapAdmin": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "secret": {
          "type": "object",
          "properties": {
            "create": { "type": "boolean" },
            "name": { "type": "string" },
            "username": { "type": "string", "description": "Bootstrap admin username in the master realm. This chart names it, so it is never the operator's temp-admin." },
            "password": { "type": "string", "default": "", "description": "Leave empty: the chart generates a 32-character password on first install and reuses the Secret's value on every upgrade (the operator applies it only at the server's first start). Set it only to choose one yourself." }
          }
        },
        "service": {
          "type": "object",
          "description": "The bootstrap admin SERVICE ACCOUNT (a confidential client) the config KOG authenticates as. Temporary: the KOG replaces it with its own permanent client.",
          "properties": {
            "enabled": { "type": "boolean" },
            "secret": {
              "type": "object",
              "properties": {
                "create": { "type": "boolean" },
                "name": { "type": "string" },
                "clientId": { "type": "string", "description": "Client id of the bootstrap service account in the master realm." },
                "clientSecret": { "type": "string", "default": "", "description": "Leave empty: generated (32 characters) on first install and reused from the Secret on every upgrade." }
              }
            }
          }
        }
      }
    },
    "operator": {
      "type": "object",
      "properties": {
        "install": { "type": "boolean" },
        "version": { "type": "string" }
      }
    }
  }
}
