{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Keycloak (Operator-managed) blueprint values",
  "type": "object",
  "properties": {
    "keycloak": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "instances": { "type": "integer", "minimum": 1 },
        "hostname": { "type": "string", "pattern": "^https://[^/?#\\s]+(/[^?#\\s]*[^/?#\\s])?$", "description": "Stable external base URL, including the https:// scheme (e.g. https://keycloak.example.com), no trailing slash. Keycloak builds the token issuer from it." },
        "image": { "type": "string" },
        "http": {
          "type": "object",
          "properties": {
            "httpEnabled": { "type": "boolean" },
            "tlsSecretName": { "type": "string" }
          }
        },
        "ingress": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "className": { "type": "string" }
          }
        },
        "proxyHeaders": { "type": "string", "enum": ["", "forwarded", "xforwarded"] },
        "additionalOptions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": { "name": { "type": "string" }, "value": { "type": "string" } },
            "required": ["name", "value"]
          }
        }
      },
      "required": ["name", "instances", "hostname"]
    },
    "db": {
      "type": "object",
      "properties": {
        "vendor": { "type": "string" },
        "database": { "type": "string" },
        "provider": { "type": "string", "enum": ["cloudnativepg", "external"] },
        "cloudnativepg": {
          "type": "object",
          "properties": {
            "clusterName": { "type": "string" },
            "instances": { "type": "integer", "minimum": 1 },
            "owner": { "type": "string" },
            "imageName": { "type": "string" },
            "storage": {
              "type": "object",
              "properties": {
                "size": { "type": "string" },
                "storageClass": { "type": "string" }
              }
            }
          },
          "required": ["clusterName", "instances", "owner"]
        },
        "host": { "type": "string" },
        "port": { "type": "integer" },
        "secret": {
          "type": "object",
          "properties": {
            "create": { "type": "boolean" },
            "name": { "type": "string" },
            "usernameKey": { "type": "string" },
            "passwordKey": { "type": "string" },
            "username": { "type": "string" },
            "password": { "type": "string" }
          },
          "required": ["name", "usernameKey", "passwordKey"]
        }
      },
      "required": ["vendor", "database", "provider"]
    },
    "bootstrapAdmin": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "secret": {
          "type": "object",
          "properties": {
            "create": { "type": "boolean" },
            "name": { "type": "string" },
            "username": { "type": "string", "description": "Bootstrap admin username in the master realm. This chart names it, so it is never the operator's temp-admin." },
            "password": { "type": "string", "default": "", "description": "Leave empty: the chart generates a 32-character password on first install and reuses the Secret's value on every upgrade (the operator applies it only at the server's first start). Set it only to choose one yourself." }
          },
          "required": ["name"]
        }
      }
    },
    "operator": {
      "type": "object",
      "properties": {
        "install": { "type": "boolean" },
        "version": { "type": "string" }
      }
    }
  },
  "required": ["keycloak", "db"]
}
